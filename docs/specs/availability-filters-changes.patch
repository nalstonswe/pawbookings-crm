+            <Form.Control.Feedback type="invalid">{errors.minRemainingCapacity}</Form.Control.Feedback>
+          </Form.Group>
+        </Col>
+        <Col md={3}>
+          <Form.Group controlId="availability-filter-state">
+            <Form.Label>Availability</Form.Label>
+            <Form.Select value={draft.state} isInvalid={Boolean(errors.state)}
+                         onChange={(event) => update('state', event.target.value)}>
+              <option value="">Any</option>
+              {AVAILABILITY_STATE_KEYS.map((key) => (
+                <option key={key} value={key}>{availabilityStateLabel(key)}</option>
+              ))}
+            </Form.Select>
+            <Form.Control.Feedback type="invalid">{errors.state}</Form.Control.Feedback>
+          </Form.Group>
+        </Col>
+      </Row>
+      <div className="d-flex gap-2 mt-3">
+        <Button type="submit" variant="primary">Submit</Button>
+        <Button type="button" variant="outline-secondary" onClick={handleClear}>Clear filters</Button>
+      </div>
+    </Form>
+  )
+}
+
+AvailabilityFilters.propTypes = {
+  services: PropTypes.arrayOf(PropTypes.shape({
+    id: PropTypes.number.isRequired,
+    name: PropTypes.string.isRequired,
+    active: PropTypes.bool,
+  })).isRequired,
+  applied: PropTypes.object.isRequired,
+  serverErrors: PropTypes.object,
+  onSubmit: PropTypes.func.isRequired,
+  onClear: PropTypes.func.isRequired,
+}
