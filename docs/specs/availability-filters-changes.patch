@@ -53,6 +53,12 @@ number of bookings ever made against them.
 
 ## Pagination: plain limit/offset, capped
 
+The one exception to the plain-array convention below is the admin
+availability list (`GET .../availability_slots`): it filters on computed
+remaining capacity, which the client can't infer from "fewer than
+`per_page` rows", so it returns `{ slots, total_count, has_more }` and
+applies those filters in SQL *before* the limit/offset.
+
 No cursor-based pagination, no `kaminari`/`will_paginate` dependency —
 `Paginatable` (`app/controllers/concerns/paginatable.rb`) is a shared
 `page`/`per_page` concern (default 25, capped at 100) used by every
@@ -84,6 +90,7 @@ column is *actually* queried together with others:
 | `bookings(business_id, created_at)` | `GET .../bookings` unfiltered — a 3-column index grouped by `status` first can't serve `ORDER BY created_at` alone efficiently |
 | `availability_slots(service_offering_id, active, starts_at)` | the customer-facing availability query (`WHERE active = true AND starts_at BETWEEN ...`) |
 | `availability_slots(service_offering_id, starts_at, ends_at)` (unique) | prevents duplicate slot windows *and* serves the plain management list ordered by `starts_at` |
+| `availability_slots(business_id, starts_at)` | the admin business-wide list (`GET .../availability_slots`), across every service |
 | `idempotency_records(business_id, user_id, endpoint, key)` (unique) | the actual concurrency guarantee — see [docs/idempotency.md](idempotency.md) |
 | `memberships(business_id, user_id)` (unique) | tenant membership resolution on every single request |
 
diff --git a/frontend/src/availability/AvailabilityFilters.jsx b/frontend/src/availability/AvailabilityFilters.jsx
new file mode 100644
index 0000000..d4d891e
--- /dev/null
+++ b/frontend/src/availability/AvailabilityFilters.jsx
@@ -0,0 +1,108 @@
+import { useState } from 'react'
+import PropTypes from 'prop-types'
+import Form from 'react-bootstrap/Form'
+import Button from 'react-bootstrap/Button'
+import Row from 'react-bootstrap/Row'
+import Col from 'react-bootstrap/Col'
+import { AVAILABILITY_STATE_KEYS, availabilityStateLabel } from '../lib/availabilityStatus'
+import { EMPTY_FILTERS, MAX_RANGE_DAYS, addDays, normalizeFilters, validateFilters } from './availabilityFilters'
+
+// Filters are edited locally and only applied on Submit (no request per
+// keystroke). Server-side 422 details for the submitted filters are
+// shown inline too, for anything the client-side checks didn't catch.
+export function AvailabilityFilters({ services, applied, serverErrors = {}, onSubmit, onClear }) {
+  const [ draft, setDraft ] = useState(() => normalizeFilters(applied))
+  const [ clientErrors, setClientErrors ] = useState({})
+  const errors = { ...serverErrors, ...clientErrors }
+
+  function update(field, value) {
+    setDraft((current) => ({ ...current, [field]: value }))
+  }
+
+  function handleSubmit(event) {
+    event.preventDefault()
+    const found = validateFilters(draft)
+    setClientErrors(found)
+    if (Object.keys(found).length === 0) onSubmit(normalizeFilters(draft))
+  }
+
+  function handleClear() {
+    setDraft(EMPTY_FILTERS)
+    setClientErrors({})
+    onClear()
+  }
+
+  return (
+    <Form onSubmit={handleSubmit} noValidate aria-label="Filter availability">
+      <Row className="g-3 align-items-start">
+        <Col md={3}>
+          <Form.Group controlId="availability-filter-service">
+            <Form.Label>Service</Form.Label>
+            <Form.Select value={draft.serviceId} onChange={(event) => update('serviceId', event.target.value)}>
+              <option value="">All services</option>
+              {services.filter((service) => service.active).map((service) => (
+                <option key={service.id} value={service.id}>{service.name}</option>
+              ))}
+            </Form.Select>
+          </Form.Group>
+        </Col>
+        <Col md={2}>
+          <Form.Group controlId="availability-filter-from">
+            <Form.Label>From</Form.Label>
+            <Form.Control type="date" value={draft.from} isInvalid={Boolean(errors.from)}
+                          onChange={(event) => update('from', event.target.value)} />
+            <Form.Control.Feedback type="invalid">{errors.from}</Form.Control.Feedback>
+          </Form.Group>
+        </Col>
+        <Col md={2}>
