+class AddBusinessStartsAtIndexToAvailabilitySlots < ActiveRecord::Migration[8.1]
+  def change
+    # The existing availability_slots indexes all lead with
+    # service_offering_id, so the business-wide, all-services list
+    # (WHERE business_id = ? AND starts_at BETWEEN ... ORDER BY starts_at, id)
+    # can't use them.
+    add_index :availability_slots, [ :business_id, :starts_at ],
+              name: "index_availability_slots_on_business_id_and_starts_at"
+  end
+end
diff --git a/backend/spec/requests/api/v1/businesses/all_availability_slots_spec.rb b/backend/spec/requests/api/v1/businesses/all_availability_slots_spec.rb
new file mode 100644
index 0000000..b52b4c6
--- /dev/null
+++ b/backend/spec/requests/api/v1/businesses/all_availability_slots_spec.rb
@@ -0,0 +1,185 @@
+require "rails_helper"
+
+RSpec.describe "Api::V1::Businesses::AllAvailabilitySlots", type: :request do
+  let!(:business) { create(:business, slug: "paws-and-play", time_zone: "America/New_York") }
+  let!(:member) { create(:user, password: "password123") }
+  let!(:daycare) { create(:service_offering, business: business, name: "Daycare") }
+  let!(:training) { create(:service_offering, business: business, name: "Training") }
+
+  before { create(:membership, business: business, user: member) }
+
+  def login_as(user)
+    post "/api/v1/session", params: { session: { email: user.email, password: "password123" } }
+  end
+
+  def slots_path(params = {})
+    "/api/v1/businesses/paws-and-play/availability_slots?#{params.to_query}"
+  end
+
+  def create_slot(offering, days_out:, **attrs)
+    create(:availability_slot, service_offering: offering, business: offering.business,
+                                starts_at: days_out.days.from_now, ends_at: days_out.days.from_now + 2.hours, **attrs)
+  end
+
+  def accept_into(slot, count)
+    count.times do
+      booking = create(:booking, :accepted, service_offering: slot.service_offering, business: slot.business,
+                                            requested_starts_at: slot.starts_at, requested_ends_at: slot.ends_at)
+      create(:booking_allocation, booking: booking, availability_slot: slot)
+    end
+  end
+
+  def slot_ids = response.parsed_body["slots"].map { |slot| slot["id"] }
+
+  def business_date(days_out) = days_out.days.from_now.in_time_zone(business.time_zone).to_date
+
+  describe "scoping" do
+    it "never returns another business's slots, even when its service id is passed" do
+      other = create(:business, slug: "city-tails")
+      other_offering = create(:service_offering, business: other)
+      create_slot(other_offering, days_out: 1)
+      mine = create_slot(daycare, days_out: 1)
+      login_as(member)
+
+      get slots_path
+      expect(slot_ids).to eq([ mine.id ])
+
+      get slots_path(service_id: other_offering.id)
+      expect(response).to have_http_status(:not_found)
+    end
+
+    it "excludes past slots" do
+      create_slot(daycare, days_out: -1)
+      login_as(member)
+
+      get slots_path
+
+      expect(slot_ids).to be_empty
+    end
+  end
+
+  describe "filters" do
+    it "stacks every filter with AND" do
+      match = create_slot(daycare, days_out: 3, capacity: 10)
+      create_slot(training, days_out: 3, capacity: 10)
+      create_slot(daycare, days_out: 5, capacity: 10)
+      create_slot(daycare, days_out: 2, capacity: 2) # too little remaining capacity
+      login_as(member)
+
+      get slots_path(
+        service_id: daycare.id, from: business_date(2), to: business_date(3),
+        min_remaining_capacity: 5, availability_state: "available"
+      )
+
+      expect(slot_ids).to eq([ match.id ])
+    end
+
+    it "treats the from/to dates as inclusive days in the business's time zone" do
+      zone = ActiveSupport::TimeZone["America/New_York"]
+      day = zone.today + 3
+      late_that_day = create(:availability_slot, service_offering: daycare, business: business,
+                                                  starts_at: zone.local(day.year, day.month, day.day, 23, 30),
+                                                  ends_at: zone.local(day.year, day.month, day.day, 23, 59))
+      create_slot(daycare, days_out: 10)
+      login_as(member)
+
+      get slots_path(from: day.to_s, to: day.to_s)
+
+      expect(slot_ids).to eq([ late_that_day.id ])
+    end
+
+    it "filters by remaining capacity, not total capacity, ignoring pending bookings" do
+      nearly_full = create_slot(daycare, days_out: 1, capacity: 5)
+      accept_into(nearly_full, 4)
+      create(:booking, service_offering: daycare, business: business) # pending: reserves nothing
+      roomy = create_slot(daycare, days_out: 2, capacity: 5)
+      login_as(member)
+
+      get slots_path(min_remaining_capacity: 2)
+
+      expect(slot_ids).to eq([ roomy.id ])
+    end
+
+    it "matches the Closed/Full/Limited/Available thresholds used by the frontend" do
+      closed = create_slot(daycare, days_out: 1, active: false)
+      full = create_slot(daycare, days_out: 2, capacity: 4).tap { |slot| accept_into(slot, 4) }
+      limited = create_slot(daycare, days_out: 3, capacity: 8).tap { |slot| accept_into(slot, 6) } # 2 left <= ceil(8 * 0.25)
+      available = create_slot(daycare, days_out: 4, capacity: 8).tap { |slot| accept_into(slot, 5) } # 3 left > 2
+      login_as(member)
+
+      { "closed" => closed, "full" => full, "limited" => limited, "available" => available }.each do |state, slot|
+        get slots_path(availability_state: state)
+        expect(slot_ids).to eq([ slot.id ]), "expected only the #{state} slot for #{state}"
+      end
+    end
+  end
+
+  describe "validation" do
+    before { login_as(member) }
+
+    it "rejects `to` without `from`" do
+      get slots_path(to: 3.days.from_now.to_date)
+
+      expect(response).to have_http_status(:unprocessable_content)
+      expect(response.parsed_body.dig("error", "details")).to have_key("to")
+    end
+
+    it "rejects `to` before `from`" do
+      get slots_path(from: 5.days.from_now.to_date, to: 2.days.from_now.to_date)
+
+      expect(response).to have_http_status(:unprocessable_content)
+    end
+
+    it "rejects a range longer than 60 days" do
+      get slots_path(from: Date.current, to: 61.days.from_now.to_date)
+
+      expect(response).to have_http_status(:unprocessable_content)
+    end
+
+    it "rejects a min remaining capacity that isn't a whole number >= 1" do
+      [ "0", "-1", "1.5", "abc" ].each do |value|
+        get slots_path(min_remaining_capacity: value)
+
+        expect(response).to have_http_status(:unprocessable_content), "expected #{value.inspect} to be rejected"
+      end
+    end
+
+    it "rejects an unknown availability state" do
+      get slots_path(availability_state: "busy")
+
+      expect(response).to have_http_status(:unprocessable_content)
+    end
+  end
+
+  describe "pagination" do
+    it "orders by starts_at then id and reports has_more / total_count" do
+      slots = Array.new(3) { |i| create_slot(daycare, days_out: i + 1) }
+      login_as(member)
+
+      get slots_path(per_page: 2)
+      body = response.parsed_body
+      expect(slot_ids).to eq(slots.first(2).map(&:id))
+      expect(body).to include("total_count" => 3, "has_more" => true)
+
+      get slots_path(per_page: 2, page: 2)
+      expect(slot_ids).to eq([ slots.last.id ])
+      expect(response.parsed_body).to include("total_count" => 3, "has_more" => false)
+    end
+
+    it "does not issue additional queries per slot" do
+      3.times { |i| create_slot(daycare, days_out: i + 1) }
+      login_as(member)
+
+      count_queries = lambda do
+        count = 0
+        ActiveSupport::Notifications.subscribed(->(*) { count += 1 }, "sql.active_record") { get slots_path }
+        count
+      end
+
+      baseline = count_queries.call
+      5.times { |i| create_slot(training, days_out: i + 10) }
+
+      expect(count_queries.call).to eq(baseline)
+    end
+  end
+end
