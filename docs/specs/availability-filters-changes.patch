--- /dev/null
+++ b/backend/app/controllers/api/v1/businesses/all_availability_slots_controller.rb
@@ -0,0 +1,56 @@
+module Api
+  module V1
+    module Businesses
+      # Admin-facing, business-wide, filterable and paginated slot list --
+      # distinct from AvailabilitySlotsController (one service's CRUD) and
+      # AvailabilitiesController (customer-facing bookable view).
+      class AllAvailabilitySlotsController < Api::V1::TenantScopedController
+        def index
+          authorize AvailabilitySlot, :index?
+
+          # 404 (not 422/empty) for another business's service, like every
+          # other tenant-scoped lookup.
+          service_offering = Current.business.service_offerings.find(params[:service_id]) if params[:service_id].present?
+          filter = AvailabilitySlotFilter.new(business: Current.business, service_offering: service_offering, params: params)
+          return render_invalid_filters(filter) unless filter.valid?
+
+          scope = filter.scope
+          total_count = scope.count
+          slots = paginate(
+            scope.select(AvailabilitySlotFilter::SELECT_SQL).includes(:service_offering).order(:starts_at, :id)
+          ).to_a
+
+          render json: {
+            time_zone: Current.business.time_zone,
+            total_count: total_count,
+            has_more: page * per_page < total_count,
+            slots: slots.map { |slot| slot_json(slot) }
+          }
+        end
+
+        private
+
+        def render_invalid_filters(filter)
+          render_error(
+            status: :unprocessable_content,
+            code: "validation_failed",
+            message: "The request could not be processed.",
+            details: filter.errors.to_hash
+          )
+        end
+
+        def slot_json(slot)
+          {
+            id: slot.id,
+            starts_at: slot.starts_at,
+            ends_at: slot.ends_at,
+            capacity: slot.capacity,
+            active: slot.active,
+            remaining_capacity: slot.remaining_capacity,
+            service: { id: slot.service_offering.id, name: slot.service_offering.name }
+          }
+        end
+      end
+    end
+  end
+end
diff --git a/backend/app/services/availability_slot_filter.rb b/backend/app/services/availability_slot_filter.rb
new file mode 100644
index 0000000..07e7bab
--- /dev/null
+++ b/backend/app/services/availability_slot_filter.rb
@@ -0,0 +1,115 @@
+# Validates the admin availability filters and builds the matching scope
+# (tenant-scoped through `business.availability_slots`). Remaining
+# capacity and the Closed/Full/Limited/Available state are computed in SQL
+# so they can be filtered *before* pagination.
+class AvailabilitySlotFilter
+  include ActiveModel::Validations
+
+  MAX_RANGE_DAYS = 60
+  STATES = %w[closed full limited available].freeze
+  # Must match LOW_CAPACITY_RATIO in frontend/src/lib/availabilityStatus.js.
+  LOW_CAPACITY_RATIO = 0.25
+
+  # Accepted bookings only -- pending requests reserve nothing (ADR 0005).
+  ACCEPTED_COUNTS_JOIN = <<~SQL.squish.freeze
+    LEFT JOIN (
+      SELECT booking_allocations.availability_slot_id, COUNT(*) AS accepted_count
+      FROM booking_allocations
+      INNER JOIN bookings ON bookings.id = booking_allocations.booking_id
+      WHERE bookings.business_id = %<business_id>d AND bookings.status = 'accepted'
+      GROUP BY booking_allocations.availability_slot_id
+    ) accepted_counts ON accepted_counts.availability_slot_id = availability_slots.id
+  SQL
+
+  REMAINING_SQL = "GREATEST(availability_slots.capacity - COALESCE(accepted_counts.accepted_count, 0), 0)".freeze
+  LIMITED_THRESHOLD_SQL = "GREATEST(1, CEIL(availability_slots.capacity * #{LOW_CAPACITY_RATIO}))".freeze
+  SELECT_SQL = "availability_slots.*, #{REMAINING_SQL} AS remaining_capacity".freeze
+
+  STATE_CONDITIONS = {
+    "closed" => "availability_slots.active = FALSE",
+    "full" => "availability_slots.active AND #{REMAINING_SQL} <= 0",
+    "limited" => "availability_slots.active AND #{REMAINING_SQL} > 0 AND #{REMAINING_SQL} <= #{LIMITED_THRESHOLD_SQL}",
+    "available" => "availability_slots.active AND #{REMAINING_SQL} > #{LIMITED_THRESHOLD_SQL}"
+  }.freeze
+
+  validate :dates_are_valid
+  validate :min_remaining_capacity_is_valid
+  validate :state_is_known
+
+  def initialize(business:, service_offering:, params:)
+    @business = business
+    @service_offering = service_offering
+    @raw_from = params[:from].presence
+    @raw_to = params[:to].presence
+    @raw_min_remaining_capacity = params[:min_remaining_capacity].presence
+    @state = params[:availability_state].presence
+  end
+
+  # Call only after `valid?`.
+  def scope
+    scope = @business.availability_slots
+                     .joins(format(ACCEPTED_COUNTS_JOIN, business_id: @business.id))
+                     .where(starts_at: window)
+    scope = scope.where(service_offering_id: @service_offering.id) if @service_offering
+    scope = scope.where("#{REMAINING_SQL} >= ?", @raw_min_remaining_capacity.to_i) if @raw_min_remaining_capacity
+    scope = scope.where(STATE_CONDITIONS.fetch(@state)) if @state
+    scope
+  end
+
+  private
+
+  def from = @from ||= parse_date(@raw_from)
+  def to = @to ||= parse_date(@raw_to)
+
+  def zone = @zone ||= Time.find_zone!(@business.time_zone)
+
+  # Future slots only, in the business's time zone; every request is
+  # bounded to MAX_RANGE_DAYS.
+  def window
+    now = Time.current
+    lower = from ? [ start_of_day(from), now ].max : now
+    upper =
+      if to then end_of_day(to)
+      elsif from then end_of_day(from + MAX_RANGE_DAYS)
+      else now + MAX_RANGE_DAYS.days
+      end
+    lower..upper
+  end
+
+  def start_of_day(date) = zone.local(date.year, date.month, date.day)
+  def end_of_day(date) = start_of_day(date).end_of_day
+
+  def parse_date(value)
+    Date.iso8601(value) if value
+  rescue ArgumentError
+    nil
+  end
+
+  def dates_are_valid
+    errors.add(:from, "must be a valid date (YYYY-MM-DD)") if @raw_from && from.nil?
+    errors.add(:to, "must be a valid date (YYYY-MM-DD)") if @raw_to && to.nil?
+    return if errors.any?
+
+    errors.add(:to, "requires a from date") if to && from.nil?
+    return unless from && to
+
+    if to < from
+      errors.add(:to, "must not be before the from date")
+    elsif (to - from).to_i > MAX_RANGE_DAYS
+      errors.add(:to, "can't be more than #{MAX_RANGE_DAYS} days after the from date")
+    end
+  end
+
+  def min_remaining_capacity_is_valid
+    return if @raw_min_remaining_capacity.nil?
+    return if @raw_min_remaining_capacity.to_s.match?(/\A\d+\z/) && @raw_min_remaining_capacity.to_i >= 1
+
+    errors.add(:min_remaining_capacity, "must be a whole number of 1 or more")
+  end
+
+  def state_is_known
+    return if @state.nil? || STATES.include?(@state)
+
+    errors.add(:availability_state, "must be one of: #{STATES.join(', ')}")
+  end
+end
