diff --git a/frontend/src/availability/availabilityFilters.js b/frontend/src/availability/availabilityFilters.js
new file mode 100644
index 0000000..ad28cb7
--- /dev/null
+++ b/frontend/src/availability/availabilityFilters.js
@@ -0,0 +1,108 @@
+import { availabilityStateKey } from '../lib/availabilityStatus'
+
+export const MAX_RANGE_DAYS = 60
+
+export const EMPTY_FILTERS = { serviceId: '', from: '', to: '', minRemainingCapacity: '', state: '' }
+
+// Blank and absent values must share one cache key.
+export function normalizeFilters(filters = {}) {
+  return Object.fromEntries(
+    Object.keys(EMPTY_FILTERS).map((key) => [ key, String(filters[key] ?? '').trim() ])
+  )
+}
+
+export function isDefaultFilters(filters) {
+  const normalized = normalizeFilters(filters)
+  return Object.keys(EMPTY_FILTERS).every((key) => normalized[key] === '')
+}
+
+// Dates are plain YYYY-MM-DD strings throughout (business-local calendar
+// days), so they compare correctly as strings.
+export function addDays(dateString, days) {
+  const date = new Date(`${dateString}T00:00:00Z`)
+  date.setUTCDate(date.getUTCDate() + days)
+  return date.toISOString().slice(0, 10)
+}
+
+function daysBetween(from, to) {
+  return Math.round((new Date(`${to}T00:00:00Z`) - new Date(`${from}T00:00:00Z`)) / 86_400_000)
+}
+
+export function localDate(value, timeZone) {
+  return new Intl.DateTimeFormat('en-CA', {
+    timeZone, year: 'numeric', month: '2-digit', day: '2-digit',
+  }).format(new Date(value))
+}
+
+// Mirrors AvailabilitySlotFilter's validations so the form can block a
+// bad submit; the server still enforces them for direct API calls.
+export function validateFilters(filters) {
+  const { from, to, minRemainingCapacity } = normalizeFilters(filters)
+  const errors = {}
+
+  if (to && !from) {
+    errors.to = 'Choose a start date before an end date.'
+  } else if (from && to && to < from) {
+    errors.to = 'The end date can\u2019t be before the start date.'
+  } else if (from && to && daysBetween(from, to) > MAX_RANGE_DAYS) {
+    errors.to = `The date range can\u2019t be longer than ${MAX_RANGE_DAYS} days.`
+  }
+
+  if (minRemainingCapacity && (!/^\d+$/.test(minRemainingCapacity) || Number(minRemainingCapacity) < 1)) {
+    errors.minRemainingCapacity = 'Enter a whole number of 1 or more.'
+  }
+
+  return errors
+}
+
+export function toRequestParams(filters) {
+  const { serviceId, from, to, minRemainingCapacity, state } = normalizeFilters(filters)
+  return {
+    ...(serviceId && { service_id: serviceId }),
+    ...(from && { from }),
+    ...(to && { to }),
+    ...(minRemainingCapacity && { min_remaining_capacity: minRemainingCapacity }),
+    ...(state && { availability_state: state }),
+  }
+}
+
+// The business-local day range a filter set covers (always future-only
+// and at most MAX_RANGE_DAYS wide, matching the server).
+export function effectiveWindow(filters, today) {
+  const { from, to } = normalizeFilters(filters)
+  const start = from || today
+  return { from: start, to: to || addDays(start, MAX_RANGE_DAYS) }
+}
+
+// A cached result can answer `next` in memory only if every row `next`
+// could match was already within the cached filter's results.
+export function canServeFrom(cached, next, today) {
+  const c = normalizeFilters(cached)
+  const n = normalizeFilters(next)
+  const cachedWindow = effectiveWindow(c, today)
+  const nextWindow = effectiveWindow(n, today)
+
+  return (
+    (!c.serviceId || c.serviceId === n.serviceId) &&
+    (!c.state || c.state === n.state) &&
+    (!c.minRemainingCapacity || (n.minRemainingCapacity !== '' && Number(n.minRemainingCapacity) >= Number(c.minRemainingCapacity))) &&
+    cachedWindow.from <= nextWindow.from &&
+    nextWindow.to <= cachedWindow.to
+  )
+}
+
+export function filterSlots(slots, filters, { timeZone, today, now = new Date() }) {
+  const { serviceId, minRemainingCapacity, state } = normalizeFilters(filters)
+  const window = effectiveWindow(filters, today)
+
+  return slots.filter((slot) => {
+    const day = localDate(slot.starts_at, timeZone)
+    return (
+      new Date(slot.starts_at) >= now &&
+      day >= window.from && day <= window.to &&
+      (!serviceId || String(slot.service.id) === serviceId) &&
+      (!minRemainingCapacity || slot.remaining_capacity >= Number(minRemainingCapacity)) &&
+      (!state || availabilityStateKey(slot) === state)
+    )
+  })
+}
diff --git a/frontend/src/availability/availabilityFilters.test.js b/frontend/src/availability/availabilityFilters.test.js
new file mode 100644
index 0000000..946f947
--- /dev/null
+++ b/frontend/src/availability/availabilityFilters.test.js
@@ -0,0 +1,86 @@
+import { describe, expect, it } from 'vitest'
+import {
+  EMPTY_FILTERS, canServeFrom, filterSlots, normalizeFilters, toRequestParams, validateFilters,
+} from './availabilityFilters'
+
+describe('validateFilters', () => {
+  it('accepts blank filters', () => {
+    expect(validateFilters(EMPTY_FILTERS)).toEqual({})
+  })
+
+  it('requires a from date when a to date is set', () => {
+    expect(validateFilters({ ...EMPTY_FILTERS, to: '2026-12-05' })).toHaveProperty('to')
+  })
+
+  it('rejects a to date before the from date', () => {
+    expect(validateFilters({ ...EMPTY_FILTERS, from: '2026-12-05', to: '2026-12-01' })).toHaveProperty('to')
+  })
+
+  it('rejects ranges longer than 60 days but allows exactly 60', () => {
+    expect(validateFilters({ ...EMPTY_FILTERS, from: '2026-12-01', to: '2027-01-30' })).toEqual({})
+    expect(validateFilters({ ...EMPTY_FILTERS, from: '2026-12-01', to: '2027-01-31' })).toHaveProperty('to')
+  })
+
+  it.each([ '0', '-1', '1.5', 'abc' ])('rejects %s as a min remaining capacity', (value) => {
+    expect(validateFilters({ ...EMPTY_FILTERS, minRemainingCapacity: value })).toHaveProperty('minRemainingCapacity')
+  })
+})
+
+describe('toRequestParams / normalizeFilters', () => {
+  it('omits blank filters so blank and absent share a cache key', () => {
+    expect(normalizeFilters({ from: ' 2026-12-01 ' })).toEqual({ ...EMPTY_FILTERS, from: '2026-12-01' })
+    expect(toRequestParams({ serviceId: '3', state: 'full' })).toEqual({ service_id: '3', availability_state: 'full' })
+  })
+})
+
+describe('canServeFrom', () => {
+  const today = '2026-12-01'
+
+  it('lets a narrower filter be answered by a broader cached one', () => {
+    expect(canServeFrom(EMPTY_FILTERS, { ...EMPTY_FILTERS, serviceId: '3', state: 'full' }, today)).toBe(true)
+    expect(canServeFrom({ ...EMPTY_FILTERS, minRemainingCapacity: '2' }, { ...EMPTY_FILTERS, minRemainingCapacity: '5' }, today)).toBe(true)
+  })
+
+  it('does not let a narrower cached filter answer a broader one', () => {
+    expect(canServeFrom({ ...EMPTY_FILTERS, serviceId: '3' }, EMPTY_FILTERS, today)).toBe(false)
+    expect(canServeFrom({ ...EMPTY_FILTERS, minRemainingCapacity: '5' }, { ...EMPTY_FILTERS, minRemainingCapacity: '2' }, today)).toBe(false)
+    expect(canServeFrom({ ...EMPTY_FILTERS, from: '2026-12-01', to: '2026-12-05' }, EMPTY_FILTERS, today)).toBe(false)
+  })
+
+  it('does not serve a date window that extends past the cached window', () => {
+    expect(canServeFrom(EMPTY_FILTERS, { ...EMPTY_FILTERS, from: '2027-01-15' }, today)).toBe(false)
+  })
+})
+
+describe('filterSlots', () => {
+  const options = { timeZone: 'America/New_York', today: '2026-12-01', now: new Date('2026-12-01T12:00:00Z') }
+  const slot = (id, startsAt, overrides = {}) => ({
+    id, starts_at: startsAt, active: true, capacity: 8, remaining_capacity: 8, service: { id: 1 }, ...overrides,
+  })
+
+  it('uses business-local calendar days, inclusive of the whole to date', () => {
+    // 03:30Z on Dec 6 is still Dec 5 in New York.
+    const lateOnTheFifth = slot(1, '2026-12-06T03:30:00Z')
+    const nextDay = slot(2, '2026-12-06T12:00:00Z')
+
+    const result = filterSlots([ lateOnTheFifth, nextDay ], { ...EMPTY_FILTERS, from: '2026-12-01', to: '2026-12-05' }, options)
+
+    expect(result.map((s) => s.id)).toEqual([ 1 ])
+  })
+
+  it('stacks service, remaining capacity, and state', () => {
+    const slots = [
+      slot(1, '2026-12-03T15:00:00Z'),
+      slot(2, '2026-12-03T16:00:00Z', { service: { id: 2 } }),
+      slot(3, '2026-12-03T17:00:00Z', { remaining_capacity: 1 }),
+    ]
+
+    const result = filterSlots(slots, { ...EMPTY_FILTERS, serviceId: '1', minRemainingCapacity: '2', state: 'available' }, options)
+
+    expect(result.map((s) => s.id)).toEqual([ 1 ])
+  })
+
+  it('drops slots that have already started', () => {
+    expect(filterSlots([ slot(1, '2026-12-01T11:00:00Z') ], EMPTY_FILTERS, options)).toEqual([])
+  })
+})
diff --git a/frontend/src/availability/useFilteredAvailabilitySlots.js b/frontend/src/availability/useFilteredAvailabilitySlots.js
new file mode 100644
index 0000000..ac2a84f
--- /dev/null
+++ b/frontend/src/availability/useFilteredAvailabilitySlots.js
@@ -0,0 +1,60 @@
+import { useMemo } from 'react'
+import { useInfiniteQuery, useQueryClient } from '@tanstack/react-query'
+import { client } from '../api/client'
+import { canServeFrom, filterSlots, localDate, normalizeFilters, toRequestParams } from './availabilityFilters'
+
+const PER_PAGE = 25
+const QUERY_KEY = 'availability_slots_filtered'
+
+// Server-filtered, paginated slots for the whole business. The role is
+// part of the key because the cached rows are only ever shown to the
+// membership that fetched them.
+//
+// On a filter change, an already-cached result for a *broader* filter can
+// answer in memory: if that cache was complete (no more pages) no request
+// is sent; if it was partial its filtered rows are shown as a placeholder
+// while the server request -- the source of truth -- replaces them.
+export function useFilteredAvailabilitySlots(businessSlug, filters, { role, timeZone }) {
+  const queryClient = useQueryClient()
+  const normalized = normalizeFilters(filters)
+  const filterKey = JSON.stringify(normalized)
+  const queryKey = [ QUERY_KEY, businessSlug, normalized, role ]
+
+  const cachedAnswer = useMemo(() => {
+    if (!timeZone) return null
+
+    const now = new Date()
+    const today = localDate(now, timeZone)
+    const candidates = queryClient
+      .getQueriesData({ queryKey: [ QUERY_KEY, businessSlug ] })
+      .filter(([ key, data ]) => data && key[3] === role && canServeFrom(key[2], normalized, today))
+      .map(([ , data ]) => data)
+    if (candidates.length === 0) return null
+
+    const complete = candidates.find((data) => !data.pages.at(-1).has_more)
+    const source = complete ?? candidates[0]
+    const slots = filterSlots(source.pages.flatMap((page) => page.slots), normalized, { timeZone, today, now })
+
+    return { complete: Boolean(complete), slots }
+    // eslint-disable-next-line react-hooks/exhaustive-deps -- recompute only when the submitted filters change
+  }, [ businessSlug, role, timeZone, filterKey ])
+
+  const query = useInfiniteQuery({
+    queryKey,
+    queryFn: async ({ pageParam }) => {
+      const { data } = await client.get(`/businesses/${businessSlug}/availability_slots`, {
+        params: { ...toRequestParams(normalized), page: pageParam, per_page: PER_PAGE },
+      })
+      return data
+    },
+    initialPageParam: 1,
+    getNextPageParam: (lastPage, allPages) => (lastPage.has_more ? allPages.length + 1 : undefined),
+    enabled: Boolean(businessSlug && timeZone) && !cachedAnswer?.complete,
+    placeholderData: cachedAnswer && {
+      pages: [ { slots: cachedAnswer.slots, total_count: cachedAnswer.slots.length, has_more: false } ],
+      pageParams: [ 1 ],
+    },
+  })
+
+  return { ...query, slots: query.data?.pages.flatMap((page) => page.slots) ?? [] }
+}
diff --git a/frontend/src/lib/availabilityStatus.js b/frontend/src/lib/availabilityStatus.js
index da3e044..19d3ad6 100644
--- a/frontend/src/lib/availabilityStatus.js
+++ b/frontend/src/lib/availabilityStatus.js
@@ -2,14 +2,34 @@
 // derived here, once, from capacity/remaining_capacity/active so every
 // page (service booking, availability management) agrees on the
 // thresholds and labels.
+//
+// The availability-state filter on GET .../availability_slots applies the
+// same rule server-side (AvailabilitySlotFilter) -- keep the two in sync.
 const LOW_CAPACITY_RATIO = 0.25
 
-export function availabilityState(slot) {
-  if (!slot.active) return { label: 'Closed', variant: 'secondary' }
-  if (slot.remaining_capacity <= 0) return { label: 'Full', variant: 'danger' }
+const STATES = {
+  closed: { label: 'Closed', variant: 'secondary' },
+  full: { label: 'Full', variant: 'danger' },
+  limited: { label: 'Limited availability', variant: 'warning' },
+  available: { label: 'Available', variant: 'success' },
+}
+
+export const AVAILABILITY_STATE_KEYS = Object.keys(STATES)
+
+export function availabilityStateKey(slot) {
+  if (!slot.active) return 'closed'
+  if (slot.remaining_capacity <= 0) return 'full'
 
   const lowCapacityThreshold = Math.max(1, Math.ceil(slot.capacity * LOW_CAPACITY_RATIO))
-  if (slot.remaining_capacity <= lowCapacityThreshold) return { label: 'Limited availability', variant: 'warning' }
+  if (slot.remaining_capacity <= lowCapacityThreshold) return 'limited'
 
-  return { label: 'Available', variant: 'success' }
+  return 'available'
+}
+
+export function availabilityStateLabel(key) {
+  return STATES[key].label
+}
+
+export function availabilityState(slot) {
+  return STATES[availabilityStateKey(slot)]
 }
